{
  "entities": {
    "album": {
      "title": "Music Album",
      "description": "Represents a music album in the storefront.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the album."
        },
        "artist": {
          "type": "string",
          "description": "The artist or band."
        },
        "genre": {
          "type": "string",
          "description": "The genre of the music."
        },
        "year": {
          "type": "integer",
          "description": "The release year."
        },
        "price": {
          "type": "number",
          "description": "The price of the album."
        },
        "coverUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the album cover image."
        },
        "stock": {
          "type": "integer",
          "description": "Number of items in stock."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the album."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the album was added to the store."
        }
      },
      "required": ["title", "artist", "price", "coverUrl"]
    }
  },
  "firestore": {
    "/albums/{albumId}": {
      "schema": "album",
      "description": "Collection of music albums."
    }
  }
}
